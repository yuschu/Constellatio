# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- Django ----
*.log
db.sqlite3
media/
staticfiles/

# ---- i18n（.po 与编译产物 .mo 一起入库）----
# 早先 .mo 不入库，靠本地文件被 build context 带进镜像；但 clone 下来跑
# runserver 会没有目录（英文界面回退中文），工具链也不再自证。现在 .mo 入库，
# 容器 entrypoint 仍会在启动时用 tools/compile_mo.py 重编一遍（幂等），
# 改了 .po 记得提交前跑 `python tools/compile_mo.py`（--check 可只校验）。
# 这里故意不写「忽略 .mo」的通配规则；.mo 是二进制，行尾转换见 .gitattributes。

# ---- 环境变量与密钥 ----
.env
.env.*
!.env.example

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp

# ---- 系统 ----
Thumbs.db
.DS_Store

# ---- 本地提示词（不上传仓库） ----
Prompt/

# ---- 本地会话记录（不推送）----
session/

# ---- 本地数据库备份 / 导出（含账号哈希，不推送）----
db.sqlite3.bak.*
db-docker-backup-*.sql

# ---- 本地对话导出 ----
dsh-chat-export.json

# ---- 本地临时目录（自检证据脚本的运行残留，不入库）----
.tmp-test/

# ---- 覆盖率数据（v1.7.15 起 coverage 生成物，不入库）----
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 本地日志目录（v1.7.5，*.log 已单独忽略）----
logs/

# ---- 早期论文/演示产物（v1.7.8 整理：不随代码提交，避免 git add -A 误带）----
dist/
docs/thesis/
docs/*.docx
docs/ref-att*.txt
docs/reference-template.*
tools/*.ps1
tools/build_thesis.py
tools/check_thesis.py
tools/draw_figures.py
tools/extract_attachments.py
tools/extract_template.py
tools/fill_att2.py
