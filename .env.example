# Constellatio 部署环境变量示例（复制为 .env 后按需修改）
OA_THEME=corporate-clean
DB_NAME=constellatio
DB_USER=constellatio
DB_PASSWORD=constellatio2026
DB_ROOT_PASSWORD=constellatio2026
DJANGO_DEBUG=0
# 必填（v1.7.15）：生产模式（DJANGO_DEBUG=0）下缺失会直接拒绝启动。
# 这里刻意留空 —— 填占位值等于让"缺 key 拒绝启动"这条保护失效。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=*
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=Constellatio@2026
GUNICORN_WORKERS=3
WEB_PORT=8000

# --- 传输安全（v1.8.0 / P1-13）---
# 默认 0：本地与 docker compose 直连 8000 端口可用。
# 生产环境应由反向代理（Nginx/Caddy）终止 TLS 并转发 X-Forwarded-Proto，然后：
#   DJANGO_HTTPS=1        会话 / CSRF Cookie 仅 HTTPS 传输，并开启 HSTS
#   DJANGO_SSL_REDIRECT=1 全站 301 到 HTTPS（反代已做跳转时不要重复开）
#   DJANGO_HSTS_SECONDS    HSTS 有效期，默认 31536000
DJANGO_HTTPS=0
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000

# --- AI 助手（v2.3.0 A 阶段）---
# 内置 Ollama 服务：首次启动自动拉取模型到 ollama_data 卷，默认 qwen3:4b。
# 只改内置模型时同时改 OLLAMA_MODEL 与 ASSISTANT_LLM_MODEL，两者保持一致。
# Docker Hub 不可达时用镜像站覆盖（保持同一 tag），例如 <镜像站>/ollama/ollama:0.40.11。
# 注意：部分国内镜像站只代理 manifest，大层会截断；以实际 `docker pull` 结果为准。
OLLAMA_IMAGE=ollama/ollama:0.40.11
OLLAMA_MODEL=qwen3:4b
# 官方 registry 拉不动时的回退源（ModelScope 的 Qwen3-4B GGUF，同一 4B/Q4_K_M）。
# 回退后会统一建成 qwen3:4b，业务侧模型名不变；设为空则关闭回退。
OLLAMA_FALLBACK_MODEL=modelscope.cn/Qwen/Qwen3-4B-GGUF:latest
# 官方源最多等 300 秒；超时就切回退，避免慢速连接把首次启动拖到几小时。
OLLAMA_PULL_TIMEOUT=300
ASSISTANT_LLM_BASE_URL=http://ollama:11434/v1
ASSISTANT_LLM_MODEL=qwen3:4b
# 内置 Ollama 通常不校验 API Key；切公网服务时再填。
ASSISTANT_LLM_API_KEY=
# 内置 Ollama 默认跑 CPU：4B 冷加载约 30–45 秒；关闭思考后单轮约 20 秒，
# 官方模型仍会思考时单轮约 3 分钟。超时低于 120 秒可能在思考段被打断，默认 240 秒。
ASSISTANT_LLM_TIMEOUT=240
ASSISTANT_LLM_MAX_TOKENS=1536

# --- 企业 SSO（v1.7.0）---
# 生产必须覆盖为网关与本系统共享的随机密钥，否则 ticket 可被伪造
SSO_SHARED_SECRET=please-change-me-to-a-long-random-string

# --- 日志（v1.7.5）---
# 默认 0：只输出 console，容器由 docker 日志驱动收集。
# 本地 runserver（单进程）想同时落盘 logs/constellatio.log 时设 1；
# 容器里保持 0 —— 3 个 worker 同时轮转同一文件会丢日志 / 写进已改名的旧文件。
DJANGO_LOG_TO_FILE=0

